@{
    ViewBag.Title = "Contacts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: #f1f4f9;
        background-image:
            radial-gradient(circle at top left, rgba(100, 149, 237, 0.15), transparent 60%),
            radial-gradient(circle at bottom right, rgba(255, 165, 0, 0.15), transparent 60%);
        color: #333;
    }

    .contact-page {
        margin-top: 1.5rem;
        padding: 2rem 1rem 1.5rem;
    }

    .contact-wrapper {
        max-width: 960px;
        margin: auto;
        display: flex;
        gap: 1.8rem;
    }

    .contact-form {
        flex: 2;
        background: #fff;
        padding: 1.8rem 2rem;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgb(0 0 0 / 0.04);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        font-size: 0.95rem;
    }

    .contact-form h2 {
        font-family: inherit;
        font-weight: inherit;
        font-size: inherit;
        margin-bottom: 1.5rem;
        color: #0d6efd;
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }


    .contact-form h2 i {
        font-size: 1.4rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    label {
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #555;
    }

    input[type="text"],
    input[type="email"],
    textarea {
        border: 1.8px solid #ddd;
        border-radius: 8px;
        padding: 0.5rem 0.85rem;
        font-size: 0.95rem;
        transition: border-color 0.3s ease;
        resize: vertical;
        min-height: 36px;
    }

    input[type="text"]:focus,
    input[type="email"]:focus,
    textarea:focus {
        outline: none;
        border-color: #0d6efd;
        box-shadow: 0 0 6px rgba(13, 110, 253, 0.2);
    }

    textarea {
        min-height: 100px;
    }

    button.btn-submit {
        margin-top: 1rem;
        background-color: #0d6efd;
        color: white;
        padding: 0.65rem 0;
        font-weight: 700;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-size: 1rem;
        transition: background-color 0.3s ease;
    }

    button.btn-submit:hover {
        background-color: #0848c8;
    }

    .social-card {
        flex: 1;
        background: linear-gradient(135deg, #0d6efd 0%, #004aad 100%);
        border-radius: 12px;
        padding: 1.8rem 2rem;
        color: white;
        box-shadow: 0 8px 20px rgb(0 0 0 / 0.1);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        font-size: 0.95rem;
        justify-content: space-between;
    }

    .social-card h3 {
        font-weight: 700;
        font-size: 1.4rem;
        margin-bottom: 1.8rem;
        letter-spacing: 0.05em;
        color: #ffcd3c;
    }

    .social-list {
        list-style: none;
        padding: 0;
        margin: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .social-list li a {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-weight: 600;
        color: white;
        text-decoration: none;
        font-size: 1.1rem;
        transition: color 0.25s ease;
    }

    .social-list li a i {
        font-size: 1.8rem;
        min-width: 30px;
        transition: color 0.25s ease;
    }

    .social-list li a:hover {
        color: #ffcd3c;
    }

    .social-list li a:hover i {
        color: #ffcd3c;
    }

    .contact-info {
        margin-top: 2.5rem;
        font-size: 0.9rem;
        color: #eee;
    }

    .contact-info p {
        margin: 0.3rem 0;
    }

    @@media (max-width: 768px) {
        .contact-wrapper {
            flex-direction: column;
        }

        .social-card {
            margin-top: 2rem;
            align-items: center;
            text-align: center;
        }

        .social-list {
            flex-direction: row;
            justify-content: center;
            flex-wrap: wrap;
            gap: 1.3rem;
        }

        .social-list li a {
            font-size: 1rem;
        }

        .social-list li a i {
            font-size: 1.4rem;
        }

        .contact-info {
            margin-top: 2rem;
            font-size: 0.85rem;
        }
    }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<div class="contact-page">
    <div class="contact-wrapper">

        <form method="post" action="@Url.Action("SendContact", "Home")" class="contact-form" novalidate>
            <h2><i class="fas fa-envelope"></i> Contactează-ne</h2>

            <div class="form-group">
                <label for="name">Nume</label>
                <input type="text" id="name" name="Name" placeholder="Numele tău" required />
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="Email" placeholder="exemplu@domeniu.com" required />
            </div>

            <div class="form-group">
                <label for="subject">Subiect</label>
                <input type="text" id="subject" name="Subject" placeholder="Subiect mesaj" required />
            </div>

            <div class="form-group">
                <label for="message">Mesaj</label>
                <textarea id="message" name="Message" placeholder="Scrie mesajul tău aici..." required></textarea>
            </div>

            <button type="submit" class="btn-submit">Trimite</button>
        </form>

        <aside class="social-card">
            <div>
                <h3>Urmărește-ne</h3>
                <ul class="social-list">
                    <li><a href="https://instagram.com/fakeprofile" target="_blank"><i class="fab fa-instagram"></i>Instagram</a></li>
                    <li><a href="https://twitter.com/fakeprofile" target="_blank"><i class="fab fa-twitter"></i>Twitter</a></li>
                    <li><a href="https://facebook.com/fakeprofile" target="_blank"><i class="fab fa-facebook-f"></i>Facebook</a></li>
                    <li><a href="https://linkedin.com/company/fakeprofile" target="_blank"><i class="fab fa-linkedin-in"></i>LinkedIn</a></li>
                    <li><a href="https://youtube.com/fakeprofile" target="_blank"><i class="fab fa-youtube"></i>YouTube</a></li>
                </ul>
            </div>

            <div class="contact-info">
                <p><strong>Adresă:</strong> Str. Exemplu 123, București</p>
                <p><strong>Telefon:</strong> 0740 000 000</p>
                <p><strong>Email:</strong> contact@nextgenpc.ro</p>
            </div>
        </aside>

    </div>
</div>
