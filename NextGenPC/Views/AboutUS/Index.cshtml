@{
    ViewBag.Title = "Despre Noi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
  body {
    background: #f1f4f9;
    background-image:
      radial-gradient(circle at top left, rgba(100, 149, 237, 0.15), transparent 60%),
      radial-gradient(circle at bottom right, rgba(255, 165, 0, 0.15), transparent 60%);
    color: #333;
  }

  .about-section {
    padding: 2rem 1rem;
  }

  .about-main-box {
    max-width: 960px;
    margin: auto;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.04);
    display: flex;
    gap: 2rem;
    padding: 1.8rem 2rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .about-image {
    flex: 1 1 350px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .about-image img {
    max-width: 100%;
    border-radius: 8px;
    height: auto;
  }

  .about-text {
    flex: 1 1 400px;
    font-size: 1rem;
    line-height: 1.6;
    color: #333;
  }

  .about-text h2 {
    color: #0d6efd;
    margin-bottom: 1rem;
    font-size: 1.8rem;
  }

  /* Boxurile cu iconițe sub cutia mare */
  .icon-box-container {
    max-width: 960px;
    margin: 2rem auto 0;
    display: flex;
    gap: 1.8rem;
    flex-wrap: nowrap; /* Nu vrem să împacheteze */
    justify-content: space-between; /* Distribuie spațiul egal */
  }

  .icon-box {
    background: #fff;
    border-radius: 12px;
    padding: 1.8rem 2rem;
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: #333;
    flex: 1 1 0; /* Se extind egal */
    max-width: none; /* elimină limitarea pe lățime */
    text-align: center;
    font-size: 0.95rem;
  }


  .icon-box i {
    font-size: 2.2rem;
    color: #0d6efd;
  }

  .icon-box h3 {
    margin: 0;
    font-weight: 700;
    font-size: 1.2rem;
  }

  @@media (max-width: 768px) {
    .about-main-box {
      flex-direction: column;
      padding: 1.5rem 1rem;
    }

    .about-image,
    .about-text {
      flex: 1 1 100%;
      max-width: 100%;
    }

    .icon-box-container {
      gap: 1rem;
    }

    .icon-box {
      max-width: 100%;
      padding: 1.5rem;
    }
  }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<section class="about-section">
    <div class="about-main-box">

        <div class="about-image">
            <img src="https://images.unsplash.com/photo-1597872200969-2b65d56bd16b?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="PC Setup modern" />
        </div>

        <div class="about-text">
            <h2>Povestea Noastră</h2>
            <p>Suntem pasionați de tehnologie și construim PC-uri personalizate cu grijă, precizie și dedicare.</p>
            <p>Fiecare sistem reflectă standarde înalte — de la gaming la lucru profesional.</p>
        </div>

    </div>

    <div class="icon-box-container">
        <div class="icon-box">
            <i class="fas fa-bolt"></i>
            <h3>Performanță</h3>
            <p>Optimizăm fiecare PC pentru viteze maxime și stabilitate.</p>
        </div>
        <div class="icon-box">
            <i class="fas fa-shield-alt"></i>
            <h3>Fiabilitate</h3>
            <p>Componente de calitate și testări riguroase pentru durabilitate.</p>
        </div>
        <div class="icon-box">
            <i class="fas fa-cogs"></i>
            <h3>Personalizare</h3>
            <p>Configurații adaptate nevoilor tale, fără compromisuri.</p>
        </div>
    </div>
</section>
