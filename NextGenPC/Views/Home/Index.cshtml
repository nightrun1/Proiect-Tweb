@{
    ViewBag.Title = "Acasă";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<!-- HERO -->
<div class="hero-section text-white d-flex align-items-center" style="
    background-image: url('https://images.unsplash.com/photo-1624705002806-5d72df19c3ad?ixlib=rb-1.2.1&auto=format&fit=crop&w=2000&q=80');
    background-size: cover;
    background-position: center;
    height: 500px;
    position: relative;
">
    <div style="background-color: rgba(0,0,0,0.5); position: absolute; top: 0; left: 0; right: 0; bottom: 0;"></div>
    <div class="container text-center position-relative" style="z-index: 2;">
        <h1 class="display-4 fw-bold">
            <span style="color: #C4C4C4;">Bine ai venit la</span>
            <span class="text-primary">NextGenPC</span>
        </h1>
        <p class="lead">Descoperă cele mai noi componente și construiește-ți PC-ul de vis.</p>
        <a href="@Url.Action("Index", "Products")" class="btn btn-lg btn-primary mt-3">
            <i class="fas fa-shopping-cart"></i> Vezi Catalogul
        </a>
    </div>
</div>

<!-- CATEGORII / FEATURES -->
<div class="container my-5">
    <div class="row text-center">
        <div class="col-md-4">
            <i class="fas fa-microchip fa-3x text-primary mb-3"></i>
            <h5>Componente de top</h5>
            <p>Procesoare, plăci video, RAM și altele de la branduri renumite.</p>
        </div>
        <div class="col-md-4">
            <i class="fas fa-tools fa-3x text-primary mb-3"></i>
            <h5>Configurator PC</h5>
            <p>Construiește-ți propriul sistem și verifică compatibilitatea pieselor.</p>
        </div>
        <div class="col-md-4">
            <i class="fas fa-shipping-fast fa-3x text-primary mb-3"></i>
            <h5>Livrare rapidă</h5>
            <p>Trimitem comanda ta în cel mai scurt timp, oriunde în țară.</p>
        </div>
    </div>
</div>

<!-- PRODUSE RECENTE -->
<div class="container mt-5">
    <h3 class="text-dark mb-4"><i class="fas fa-star text-warning"></i> Produse noi</h3>
    @if (ViewBag.NewProducts != null && ((List<NextGenPC.Models.Products.ProductDataModel>)ViewBag.NewProducts).Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var product in (List<NextGenPC.Models.Products.ProductDataModel>)ViewBag.NewProducts)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow rounded-4">
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;" />
                        <div class="card-body">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text text-muted">Specificatii: @product.Specifications</p>
                            <p class="fw-bold text-primary">@product.Price.ToString("0.00") lei</p>
                            <a href="@Url.Action("Details", "Products", new { id = product.Id })" class="btn btn-outline-primary btn-sm">Detalii</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Nu există produse adăugate recent.</p>
    }
</div>