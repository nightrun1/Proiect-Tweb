@model NextGenPC.Models.Authentication.UserDataRegister
@{
    ViewBag.Title = "Register";
}

<div class="container py-5">
    <div class="background-image"></div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow rounded-4 border-0">
                <div class="card-body p-5">
                    <h2 class="mb-4 text-center text-primary fw-bold">Crează un cont</h2>

                    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Nume utilizator" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "exemplu@email.com" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-floating mb-3">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Parolă" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-floating mb-4">
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirmă parola" })
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">Înregistrează-te</button>
                    }

                    <div class="text-center mt-4">
                        <small>Ai deja cont? <a href="@Url.Action("Login", "Account")" class="text-decoration-none fw-medium">Autentifică-te aici</a>.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
