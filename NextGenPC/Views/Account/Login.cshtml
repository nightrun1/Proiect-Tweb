@model NextGenPC.Models.Authentication.UserDataLogin
@{
    ViewBag.Title = "Login";
}

<div class="container py-5">
    <div class="background-image"></div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow rounded-4 border-0">
                <div class="card-body p-5">
                    <h2 class="mb-4 text-center text-primary fw-bold">Autentificare</h2>

                    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.NameOrEmail, new { @class = "form-control", type = "email", placeholder = "Email" })
                            @Html.ValidationMessageFor(m => m.NameOrEmail, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-floating mb-4">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Parolă" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">Autentifică-te</button>
                    }

                    <div class="text-center mt-4">
                        <small>Nu ai cont? <a href="@Url.Action("Register", "Account")" class="text-decoration-none fw-medium">Înregistrează-te aici</a>.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
