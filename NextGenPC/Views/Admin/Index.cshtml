@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: #f4f7fa;
        background-image: radial-gradient(circle at top left, rgba(100,149,237,0.1), transparent 60%), radial-gradient(circle at bottom right, rgba(255,165,0,0.1), transparent 60%);
    }

    .admin-dashboard h2 {
        font-weight: 600;
        margin-bottom: 2rem;
    }

    .dashboard-card {
        background: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

        .dashboard-card:hover {
            box-shadow: 0 0 15px rgba(33, 150, 243, 0.2);
            transform: translateY(-4px);
        }

        .dashboard-card h5 {
            font-weight: 600;
            font-size: 1.2rem;
            margin-bottom: 0.5rem;
        }

        .dashboard-card p {
            font-size: 0.95rem;
            color: #555;
        }

        .dashboard-card a.btn {
            margin-top: 1rem;
            background-color: #2196f3;
            color: #fff;
            font-size: 0.85rem;
            padding: 0.4rem 1.2rem;
            border-radius: 8px;
        }

            .dashboard-card a.btn:hover {
                background-color: #1976d2;
            }
</style>

<div class="container admin-dashboard mt-5">
    <h2>Admin Dashboard</h2>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="dashboard-card">
                <h5>Utilizatori</h5>
                <p>Gestionează utilizatorii existenți din sistem.</p>
                <a href="@Url.Action("Users", "Admin")" class="btn btn-sm">Deschide</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="dashboard-card">
                <h5>Comenzi</h5>
                <p>Monitorizează comenzile plasate de clienți.</p>
                <a href="@Url.Action("Orders", "Admin")" class="btn btn-sm">Deschide</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="dashboard-card">
                <h5>Produse</h5>
                <p>Adaugă, editează sau șterge produse.</p>
                <a href="@Url.Action("Products", "Admin")" class="btn btn-sm">Deschide</a>
            </div>
        </div>
    </div>
</div>