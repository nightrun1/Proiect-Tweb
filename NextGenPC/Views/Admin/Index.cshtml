@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var latestProducts = ViewBag.LatestProducts as List<NextGenPC.Models.Products.ProductDataModel>;
}

<style>
    body {
        background: #f1f4f9;
        background-image: radial-gradient(circle at top left, rgba(100, 149, 237, 0.15), transparent 60%), radial-gradient(circle at bottom right, rgba(255, 165, 0, 0.15), transparent 60%);
    }

    .transition-all {
        transition: all 0.3s ease;
    }

    .card-hover:hover {
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1) !important;
    }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<div class="container admin-dashboard mt-5">
    <div class="mb-4">
        <h2 class="text-dark">
            <i class="fas fa-tachometer-alt text-primary"></i> Dashboard administrare
        </h2>
        <p class="text-muted">Bun venit, @(Session["UserName"] ?? "Admin")!</p>
    </div>

    <!-- Butoane administrare + statistici ca al 4-lea card -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 d-flex flex-column justify-content-between transition-all card-hover">
                <div>
                    <h5 class="fw-semibold text-dark mb-3">Utilizatori</h5>
                    <p class="text-muted">Gestionează utilizatorii existenți din sistem.</p>
                </div>
                <a href="@Url.Action("Users", "Admin")" class="btn btn-primary w-100 rounded mt-3">Deschide</a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 d-flex flex-column justify-content-between transition-all card-hover">
                <div>
                    <h5 class="fw-semibold text-dark mb-3">Comenzi</h5>
                    <p class="text-muted">Monitorizează comenzile plasate de clienți.</p>
                </div>
                <a href="@Url.Action("Orders", "Admin")" class="btn btn-primary w-100 rounded mt-3">Deschide</a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 d-flex flex-column justify-content-between transition-all card-hover">
                <div>
                    <h5 class="fw-semibold text-dark mb-3">Produse</h5>
                    <p class="text-muted">Adaugă, editează sau șterge produse.</p>
                </div>
                <a href="@Url.Action("Products", "Admin")" class="btn btn-primary w-100 rounded mt-3">Deschide</a>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 transition-all card-hover">
                <h5 class="fw-semibold text-dark mb-3">Statistici</h5>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="small text-primary fw-bold">Produse</div>
                        <div class="fw-semibold">@ViewBag.ProductCount</div>
                    </div>
                    <i class="fas fa-box text-primary"></i>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="small text-danger fw-bold">Stoc redus</div>
                        <div class="fw-semibold">@ViewBag.LowStock</div>
                    </div>
                    <i class="fas fa-exclamation-triangle text-danger"></i>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-success fw-bold">Utilizatori</div>
                        <div class="fw-semibold">@ViewBag.UserCount</div>
                    </div>
                    <i class="fas fa-users text-success"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Produse recente -->
    <div class="my-5">
        <h4 class="text-dark mb-4">Ultimele produse adăugate</h4>
        @if (latestProducts != null && latestProducts.Any())
        {
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var product in latestProducts)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 transition-all card-hover">
                            <img src="@(!string.IsNullOrEmpty(product.ImageUrl) ? product.ImageUrl : Url.Content("~/images/no-image.png"))"
                                 class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;" />
                            <div class="card-body">
                                <h5 class="card-title">@product.Name</h5>
                                <p class="card-text text-muted">Specificatii: @product.Specifications</p>
                                <p class="fw-bold text-primary">@product.Price.ToString("0.00") lei</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">Nu există produse recente.</p>
        }
    </div>
</div>
