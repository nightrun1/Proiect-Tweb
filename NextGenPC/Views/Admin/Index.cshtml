@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="mb-4">Panou de administrare</h2>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-3" style="background-color: #F4A141; color: #ffffff;">
                <div class="card-body">
                    <h5 class="card-title" style="color: #000000;">Utilizatori</h5>
                    <p class="card-text">Vizualizează și gestionează utilizatorii.</p>
                    <a href="@Url.Action("Users", "Admin")" class="btn btn-light btn-sm">Deschide</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-3" style="background-color: #F4A141; color: #ffffff;">
                <div class="card-body">
                    <h5 class="card-title" style="color: #000000;">Comenzi</h5>
                    <p class="card-text">Monitorizează comenzile efectuate.</p>
                    <a href="@Url.Action("Orders", "Admin")" class="btn btn-light btn-sm">Deschide</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-3" style="background-color: #F4A141; color: #ffffff;">
                <div class="card-body">
                    <h5 class="card-title" style="color: #000000;">Produse</h5>
                    <p class="card-text">Adaugă, editează sau șterge produse.</p>
                    <a href="@Url.Action("Products", "Admin")" class="btn btn-light btn-sm">Deschide</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS and dependencies -->
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="@Html.Raw("https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.2/dist/umd/popper.min.js")"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>