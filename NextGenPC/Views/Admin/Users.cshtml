@model IEnumerable<NextGenPC.Models.Users.UserDataModel>

@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
}

<div class="container mt-5">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-dark">
                <i class="fas fa-users text-primary mr-2"></i> Utilizatori înregistrați
            </h4>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Înapoi
            </a>
        </div>
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <p class="text-muted">Nu există utilizatori înregistrați.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle">
                        <thead class="thead-light">
                            <tr>
                                <th>#</th>
                                <th>Nume complet</th>
                                <th>Email</th>
                                <th>Rol</th>
                                <th>Data înregistrării</th>
                                <th>Acțiuni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Id</td>
                                    <td>@user.Name</td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="badge @(user.Level.ToString() == "Admin" ? "badge-danger" : "badge-info")">
                                            @user.Level
                                        </span>
                                    </td>
                                    <td>@user.LastLogin.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <a href="@Url.Action("DetailsUser", "Admin", new { id = user.Id })" class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye"></i> Detalii
                                        </a>
                                        <a href="@Url.Action("DeleteUser", "Admin", new { id = user.Id })" class="btn btn-sm btn-danger" onclick="return confirm('Ești sigur că vrei să ștergi acest utilizator?');">
                                            <i class="fas fa-trash-alt"></i> Șterge
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
