@model List<NextGenPC.Models.Products.ProductDataModel>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <h2 class="mb-4">Produsele Noastre</h2>

    <div class="row">
        <!-- Sidebar Filtru simplu -->
        <nav id="sidebarFilter" class="col-md-3 d-none d-md-block bg-light border" style="position: sticky; top: 0; height: 100vh; overflow-y: auto; padding: 1rem;">
            <h4 class="mb-4">Filtru produse</h4>

            <!-- Filtru Preț -->
            <div class="mb-4">
                <label for="price_min" class="font-weight-bold">Preț minim</label>
                <input type="number" id="price_min" class="form-control form-control-sm" placeholder="Ex: 1000" min="0" />
            </div>

            <div class="mb-4">
                <label for="price_max" class="font-weight-bold">Preț maxim</label>
                <input type="number" id="price_max" class="form-control form-control-sm" placeholder="Ex: 150000" min="0" />
            </div>

            <!-- Filtru Nume produs -->
            <div class="mb-4">
                <label for="product_name" class="font-weight-bold">Nume produs conține</label>
                <input type="text" id="product_name" class="form-control form-control-sm" placeholder="Ex: placa video" />
            </div>

            <button id="applyFilterBtn" class="btn btn-primary btn-sm">Aplică filtrul</button>
            <button id="resetFilterBtn" class="btn btn-outline-secondary btn-sm ml-2">Resetare</button>
        </nav>

        <!-- Zona Produse -->
        <main class="col-md-9">
            <div class="row" id="productList">
                @foreach (var product in Model)
                {
                    <div class="col-sm-6 col-md-4 mb-4 product-item" data-price="@product.Price" data-name="@product.Name.ToLower()">
                        <div class="card h-100 shadow-sm">
                            <a href="@Url.Action("Details", "Products", new { id = product.Id })" class="text-decoration-none">
                                <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" />
                            </a>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@product.Name</h5>
                                <p class="card-text text-muted">@product.Specifications</p>
                                <div class="mt-auto">
                                    <h6 class="text-primary font-weight-bold">@product.Price.ToString("N0") lei</h6>
                                    <a href="@Url.Action("Details", "Products", new { id = product.Id })" class="btn btn-sm btn-outline-primary mt-2">Vezi detalii</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </main>
    </div>
</div>

<script>
    document.getElementById('applyFilterBtn').addEventListener('click', function () {
        const minPrice = parseInt(document.getElementById('price_min').value) || 0;
        const maxPrice = parseInt(document.getElementById('price_max').value) || Infinity;
        const nameFilter = document.getElementById('product_name').value.toLowerCase();

        document.querySelectorAll('.product-item').forEach(item => {
            const price = parseInt(item.getAttribute('data-price'));
            const name = item.getAttribute('data-name');

            const matchPrice = price >= minPrice && price <= maxPrice;
            const matchName = name.includes(nameFilter);

            if (matchPrice && matchName) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
        });
    });
</script>

<script>
    document.getElementById('resetFilterBtn').addEventListener('click', function () {
        document.getElementById('price_min').value = '';
        document.getElementById('price_max').value = '';
        document.getElementById('product_name').value = '';

        document.querySelectorAll('.product-item').forEach(item => item.style.display = '');
    });
</script>

