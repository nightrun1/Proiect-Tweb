        <div class="cart-total">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span>Total:</span>
                <span class="cart-total-amount">$0</span>
            </div>
            <button class="btn-checkout" onclick="checkout()">Proceed to Checkout</button>
