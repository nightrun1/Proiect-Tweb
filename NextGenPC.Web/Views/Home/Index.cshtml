<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NextGen PC</title>
    <!-- Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .hero-image {
            position: relative;
            height: 500px;
            overflow: hidden;
        }
        .hero-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .hero-text {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            color: white;
            display: flex;
            align-items: center;
        }
        .cyan-text {
            color: #00ffff;
        }
        .product-card {
            transition: transform 0.2s;
        }
        .product-card:hover {
            transform: translateY(-5px);
        }
        .btn-view-details {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            transition: background-color 0.2s;
        }
        .btn-view-details:hover {
            background-color: #0056b3;
        }
    </style>
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container navbar-container d-flex justify-content-between">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">NextGen PC</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarTogglerDemo02"
                    aria-controls="navbarTogglerDemo02" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarTogglerDemo02">
                <ul class="navbar-nav ml-auto mt-2 mt-lg-0">
                    <li class="nav-item active">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">Home <span class="sr-only">(current)</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("AboutUs", "Home")">About us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Contacts", "Home")">Contacts</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Image -->
    <div class="hero-image">
        <img src="https://images.unsplash.com/photo-1624705002806-5d72df19c3ad?ixlib=rb-1.2.1&auto=format&fit=crop&w=2000&q=80" alt="Hero Image">
        <div class="hero-text">
            <div class="container mt-4">
                <h1>Welcome to NextGen PC</h1>
                <p>Take your feelings to a <span class="cyan-text">next</span> level.</p>
            </div>
        </div>
    </div>

    <!-- Filters and Product Grid -->
    <div class="container mt-4">
        <div class="row">
            <!-- Filters -->
            <div class="col-lg-3 bg-white p-4 rounded-lg shadow-sm">
                <h2 class="text-lg font-semibold mb-4">Filters</h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Price Range ($)</label>
                        <input type="range" class="form-control-range" min="0" max="5000">
                        <div class="d-flex justify-content-between text-sm text-gray-600 mt-1">
                            <span>$0</span>
                            <span>$5000</span>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Power Consumption (W)</label>
                        <input type="range" class="form-control-range" min="0" max="1200">
                        <div class="d-flex justify-content-between text-sm text-gray-600 mt-1">
                            <span>0W</span>
                            <span>1200W</span>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">RAM</label>
                        <select class="form-control">
                            <option value="all">All</option>
                            <option value="32">32GB</option>
                            <option value="64">64GB</option>
                            <option value="128">128GB</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Storage</label>
                        <select class="form-control">
                            <option value="all">All</option>
                            <option value="2000">2TB</option>
                            <option value="4000">4TB</option>
                            <option value="8000">8TB</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Processor</label>
                        <select class="form-control">
                            <option value="all">All</option>
                            <option value="Intel i9-13900K">Intel i9-13900K</option>
                            <option value="AMD Ryzen 9 7950X">AMD Ryzen 9 7950X</option>
                            <option value="Intel i9-13900KS">Intel i9-13900KS</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Graphics Card</label>
                        <select class="form-control">
                            <option value="all">All</option>
                            <option value="RTX 4070">RTX 4070</option>
                            <option value="RTX 4080">RTX 4080</option>
                            <option value="RTX 4090">RTX 4090</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Product Grid -->
            <div class="col-lg-9">
                <div class="row">
                    <!-- Product 1 -->
                    <div class="col-md-6 col-xl-4 mb-4">
                        <div class="card h-100 product-card">
                            <img src="https://images.unsplash.com/photo-1587202372775-e229f172b9d7?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Gaming Beast Pro">
                            <div class="card-body">
                                <h5 class="card-title">Gaming Beast Pro</h5>
                                <p class="card-text">$2499</p>
                                <p class="card-text">Power: 850W</p>
                                <p class="card-text">RAM: 32GB</p>
                                <p class="card-text">Storage: 2TB</p>
                                <p class="card-text">CPU: Intel i9-13900K</p>
                                <p class="card-text">GPU: RTX 4080</p>
                                <a href="#" class="btn btn-view-details w-100">View Details</a>
                            </div>
                        </div>
                    </div>
                    <!-- Product 2 -->
                    <div class="col-md-6 col-xl-4 mb-4">
                        <div class="card h-100 product-card">
                            <img src="https://images.unsplash.com/photo-1591488320449-011701bb6704?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Workstation Elite">
                            <div class="card-body">
                                <h5 class="card-title">Workstation Elite</h5>
                                <p class="card-text">$1899</p>
                                <p class="card-text">Power: 750W</p>
                                <p class="card-text">RAM: 64GB</p>
                                <p class="card-text">Storage: 4TB</p>
                                <p class="card-text">CPU: AMD Ryzen 9 7950X</p>
                                <p class="card-text">GPU: RTX 4070</p>
                                <a href="#" class="btn btn-view-details w-100">View Details</a>
                            </div>
                        </div>
                    </div>
                    <!-- Product 3 -->
                    <div class="col-md-6 col-xl-4 mb-4">
                        <div class="card h-100 product-card">
                            <img src="https://images.unsplash.com/photo-1593640495253-23196b27a87f?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" class="card-img-top" alt="Creator's Dream">
                            <div class="card-body">
                                <h5 class="card-title">Creator's Dream</h5>
                                <p class="card-text">$3299</p>
                                <p class="card-text">Power: 1000W</p>
                                <p class="card-text">RAM: 128GB</p>
                                <p class="card-text">Storage: 8TB</p>
                                <p class="card-text">CPU: Intel i9-13900KS</p>
                                <p class="card-text">GPU: RTX 4090</p>
                                <a href="#" class="btn btn-view-details w-100">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html> 